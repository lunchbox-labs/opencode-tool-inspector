{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Typechecks the host packages against core's source; their builds use core's declarations.
    "paths": {
      "@lunchbox-labs/tool-inspector-core": ["./packages/core/src/index.ts"]
    },
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/core/tests/**/*.ts",
    "packages/opencode/src/**/*.ts",
    "packages/opencode/tests/**/*.ts"
  ]
}
