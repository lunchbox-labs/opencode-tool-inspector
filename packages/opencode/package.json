{
  "name": "@lunchbox-labs/opencode-tool-inspector",
  "version": "0.3.0",
  "description": "Inspect the tools available to OpenCode agents from the TUI",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunchbox-labs/opencode-tool-inspector.git",
    "directory": "packages/opencode"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:package": "node --experimental-strip-types --test tests/package.integration.ts"
  },
  "dependencies": {
    "@lunchbox-labs/tool-inspector-core": "0.3.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@opencode-ai/sdk": "1.19.5",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
